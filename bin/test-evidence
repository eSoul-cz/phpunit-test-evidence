#!/usr/bin/env php
<?php

declare(strict_types=1);

use Esoul\TestEvidence\Cli\Application;

$autoloader = $GLOBALS['_composer_autoload_path'] ?? null;

foreach ([$autoloader, __DIR__ . '/../../../autoload.php', __DIR__ . '/../vendor/autoload.php'] as $candidate) {
    if (is_string($candidate) && is_file($candidate)) {
        require $candidate;

        break;
    }
}

if (!class_exists(Application::class)) {
    fwrite(STDERR, "test-evidence: cannot find the Composer autoloader.\n");

    exit(2);
}

exit((new Application)->run(array_slice($argv, 1), (string) getcwd()));
