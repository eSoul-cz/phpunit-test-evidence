{
  "name": "esoul-cz/phpunit-test-evidence",
  "description": "PHPUnit extension and CLI that turn a tagged group of tests into a Markdown evidence report, optionally compared against the code before a fix.",
  "type": "library",
  "license": "gpl-2.0-or-later",
  "keywords": [
    "phpunit",
    "testing",
    "report",
    "evidence",
    "regression"
  ],
  "authors": [
    {
      "name": "Tomáš Vojík",
      "email": "vojik@esoul.cz"
    }
  ],
  "require": {
    "php": "^8.3",
    "ext-json": "*",
    "phpunit/phpunit": "^12.0 || ^13.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^2",
    "esoul-cz/coding-standard": "^0.1"
  },
  "autoload": {
    "psr-4": {
      "Esoul\\TestEvidence\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    },
    "exclude-from-classmap": [
      "tests/Fixtures/"
    ]
  },
  "bin": [
    "bin/test-evidence"
  ],
  "scripts": {
    "phpstan": "phpstan analyse --memory-limit=1G --no-progress",
    "cs": "php-cs-fixer fix --dry-run --diff",
    "cs:fix": "php-cs-fixer fix",
    "test": "phpunit"
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
